# LLM — set at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Whisper model: tiny (recommended on Render free) | base | small | medium
WHISPER_MODEL_SIZE=tiny

# Skip heavy embedding models (keeps Render free tier from OOM)
LIGHT_MODE=true

# Local file storage (videos, audio, artifacts)
STORAGE_DIR=

# Processing limits
MAX_VIDEO_DURATION_SECONDS=180
MAX_UPLOAD_SIZE_MB=100
HIGHLIGHT_TARGET_DURATION_SECONDS=60
MAX_CONCURRENT_JOBS=1
MAX_SUMMARY_INPUT_TOKENS=50000

# Database
# Preferred for production: Supabase Postgres connection string
# (Project Settings → Database → Connection string → URI)
DATABASE_URL=
# Optional Supabase client credentials (for Storage / Auth later)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS (comma-separated). Production: your Vercel URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
